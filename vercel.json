{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" \"$VERCEL_GIT_COMMIT_SHA\" -- frontend api content src migrations vercel.json",
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/assessments.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "{frontend,.github,docs,tests,scripts,node_modules,.vercel}/**"
      }
    },
    {
      "src": "api/catalog.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "{frontend,.github,docs,tests,scripts,node_modules,.vercel}/**"
      }
    },
    {
      "src": "api/content.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "{frontend,.github,docs,tests,scripts,node_modules,.vercel}/**"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/curriculum/nodes",
      "destination": "/api/catalog.py?route=curriculum/nodes"
    },
    {
      "source": "/api/catalog/:path*",
      "destination": "/api/catalog.py?route=catalog/:path*"
    },
    {
      "source": "/api/curriculum/:path*",
      "destination": "/api/catalog.py?route=curriculum/:path*"
    },
    {
      "source": "/api/content/:path*",
      "destination": "/api/content.py?route=content/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/assessments.py?route=:path*"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/frontend/:path*"
    }
  ]
}