{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "ignoreCommand": "if git cat-file -e \"$VERCEL_GIT_PREVIOUS_SHA^{commit}\" 2>/dev/null; then git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" \"$VERCEL_GIT_COMMIT_SHA\" -- frontend api content src migrations vercel.json; else exit 1; fi",
  "functions": {
    "api/assessments.py": {
      "excludeFiles": "{frontend/**,.github/**,docs/**,tests/**,scripts/**,node_modules/**,.vercel/**,content/samhita/**/chapter.json,content/samhita/**/adhyaya-*.json}"
    },
    "api/catalog.py": {
      "excludeFiles": "{frontend/**,.github/**,docs/**,tests/**,scripts/**,node_modules/**,.vercel/**,content/**}"
    },
    "api/content.py": {
      "excludeFiles": "{frontend/**,.github/**,docs/**,tests/**,scripts/**,node_modules/**,.vercel/**}"
    },
    "api/curriculum_content.py": {
      "excludeFiles": "{frontend/**,.github/**,docs/**,tests/**,scripts/**,node_modules/**,.vercel/**,content/samhita/**}"
    }
  },
  "rewrites": [
    {
      "source": "/samhita/:text/:section/:chapter",
      "destination": "/samhita-study.html?chapter=:text.:section.:chapter"
    },
    {
      "source": "/samhita/:text/:section",
      "destination": "/samhita.html?text=:text&section=:section"
    },
    {
      "source": "/api/content/:path*",
      "destination": "/api/content.py?route=content/:path*"
    },
    {
      "source": "/api/curriculum/content",
      "destination": "/api/curriculum_content.py"
    },
    {
      "source": "/api/samhita-ai",
      "destination": "/api/samhita-ai.py"
    },
    {
      "source": "/api/curriculum/nodes",
      "destination": "/api/catalog.py?route=curriculum/nodes"
    },
    {
      "source": "/api/catalog/:path*",
      "destination": "/api/catalog.py?route=catalog/:path*"
    },
    {
      "source": "/api/curriculum/:path*",
      "destination": "/api/catalog.py?route=curriculum/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/assessments.py?route=:path*"
    }
  ],
  "outputDirectory": "frontend"
}